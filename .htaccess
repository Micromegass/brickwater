# Apache configuration for goneo (and any other classic shared host).
#
# This is the counterpart to public/_headers, which only Cloudflare Pages reads.
# GitHub Pages ignores both and can send no custom headers at all, which is why
# the preview there is the one deployment without a content security policy.
#
# Every block is wrapped in <IfModule>. On shared hosting a directive from a
# module that is not loaded is a 500 on every request, and this file ships with
# the site rather than being installed by hand, so it has to be safe to upload
# onto a server whose module list we do not control.

# ---------------------------------------------------------------- headers
<IfModule mod_headers.c>
  # CSP: the static export inlines Next's RSC payload scripts, so 'unsafe-inline'
  # for script-src is unavoidable without nonces, which static hosting cannot do.
  # No eval is needed: the site ships no WebGL and no animation library. Frames
  # are limited to the two providers that only load after a click.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; media-src 'self'; frame-src https://www.youtube-nocookie.com https://bandcamp.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"

  # Fingerprinted assets never change under the same name.
  <FilesMatch "\.(webp|avif|png|jpg|jpeg|svg|ico|woff2|js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # HTML is the one thing that must not be held: a rebuild has to be visible.
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.ics$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
</IfModule>

# ---------------------------------------------------------------- mime types
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType image/avif .avif
  AddType text/calendar .ics
  AddType application/manifest+json .webmanifest
  AddType font/woff2 .woff2
  AddType image/svg+xml .svg
  AddCharset UTF-8 .html .css .js .json .xml .txt .ics .webmanifest
</IfModule>

# ---------------------------------------------------------------- compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml text/calendar
  AddOutputFilterByType DEFLATE application/javascript application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml application/manifest+json
</IfModule>

# ---------------------------------------------------------------- routing
# The export writes every route as a directory with an index.html, which Apache
# serves natively. Nothing needs rewriting; only the error page is wired up.
DirectoryIndex index.html
ErrorDocument 404 /404.html

# No directory listings anywhere.
<IfModule mod_autoindex.c>
  Options -Indexes
</IfModule>

# The site's canonical URLs are all on www, so the bare domain redirects there.
# Matched exactly, so a staging subdomain is never caught by it. goneo already
# forces HTTPS, so that redirect is deliberately not repeated here.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^brickwater\.de$ [NC]
  RewriteRule ^(.*)$ https://www.brickwater.de/$1 [R=301,L]
</IfModule>
